[Unit]
Description=Checkin Backend Service (5004)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/apps/checkin
ExecStart=/usr/bin/python3 /opt/apps/checkin/app_checkin.py
Restart=always
RestartSec=5
StandardOutput=append:/var/log/app-checkin.log
StandardError=append:/var/log/app-checkin.log

[Install]
WantedBy=multi-user.target